rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Anyone who joined the match may close it, either with a score or by cancelling it,
    // for an hour after it started (the app's RESULT_WINDOW_MINUTES), so old games can't
    // be logged late. Join docs are keyed {sessionId}_{uid}, so membership is a single
    // lookup.
    //
    // A score is final: the first one stands and nothing can follow it. A cancellation is
    // not: within the same hour a score may still be logged over it. Otherwise whoever is
    // losing could cancel before the winners log the result, and the game would vanish.
    function canScoreMatch(sessionId) {
      return !('result' in resource.data)
        && request.time < resource.data.startedAt + duration.value(1, 'h')
        && exists(/databases/$(database)/documents/sessionJoins/$(sessionId + '_' + request.auth.uid));
    }

    function canCancelMatch(sessionId) {
      return canScoreMatch(sessionId) && !('cancelled' in resource.data);
    }

    // Cancelling records who did it and when, and nothing else.
    function isValidCancel(sessionId) {
      let cancelled = request.resource.data.cancelled;
      return canCancelMatch(sessionId)
        && cancelled.keys().hasOnly(['by', 'byName', 'at'])
        && cancelled.by == request.auth.uid
        && cancelled.byName is string && cancelled.byName.size() <= 100
        && cancelled.at == request.time;
    }

    // The teams are picked once, when the match fills. Whoever stores them first decides;
    // after that they can't be swapped, so a lineup never changes mid-game.
    function teamsSetOnce() {
      return !('teams' in resource.data)
        ? (!('teams' in request.resource.data) || request.resource.data.teams is list)
        : request.resource.data.teams == resource.data.teams;
    }

    function isValidResult(sessionId) {
      let result = request.resource.data.result;
      // A finished game is exactly one side on 10 with the other below it.
      return canScoreMatch(sessionId)
        && result.recordedBy == request.auth.uid
        && result.red is int && result.blue is int
        && result.red >= 0 && result.blue >= 0
        && ((result.red == 10 && result.blue < 10) || (result.blue == 10 && result.red < 10))
        && result.lineup is string && result.lineup.size() <= 300;
    }

    match /tables/{tableCode} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /tableIntegrations/{tableCode} {
      // Slack webhook URLs are secrets, so they live here instead of on the
      // world-readable table doc. The sender reads them with the Admin SDK,
      // which bypasses these rules.
      allow read, write: if isAdmin();
    }

    match /tableMembers/{memberId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn();
      // Three distinct updates: the bookkeeping while a match fills (the join counter,
      // whose transaction on this doc is what serialises simultaneous joins, the "game on"
      // and "timed out" claims, and the teams), the final score, and a cancellation. Any
      // player in the match may write one of the last two, once.
      allow update: if isSignedIn() && (
        (changesOnly(['readyNotifiedAt', 'playerCount', 'expiredNotifiedAt', 'teams']) && teamsSetOnce())
        || (changesOnly(['result']) && isValidResult(sessionId))
        || (changesOnly(['cancelled']) && isValidCancel(sessionId))
      );
    }

    match /sessionJoins/{joinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && resource.data.toUid == request.auth.uid;
    }

    match /pushTokens/{tokenId} {
      // Each user manages only their own device tokens. The push sender reads them
      // with the Admin SDK, which bypasses these rules.
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
